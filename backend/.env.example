# ==========================================
# RoleFit AI - Backend Environment Variables
# ==========================================

PORT=5000
NODE_ENV=production

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rolefit_ai?retryWrites=true&w=majority

# JWT Secrets for session handling
JWT_SECRET=your_super_secret_jwt_access_token_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here

# Google OAuth 2.0 Client ID (Must match the frontend Google Client ID)
GOOGLE_CLIENT_ID=453441074758-jfautbovm5bqn09o79v3bhn5a859mb49.apps.googleusercontent.com

# Frontend origin URL for CORS (no trailing slash)
FRONTEND_URL=https://ai-compatibility-score.vercel.app

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Resend API Key for OTP & Emails
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=RoleFit AI <onboarding@resend.dev>
